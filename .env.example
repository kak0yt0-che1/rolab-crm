# Порт HTTP-сервера
PORT=3000

# Секрет подписи JWT — обязателен; сгенерируйте: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Строка подключения MongoDB (Atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/rolab

# production отключает /api/dev и скрывает тексты внутренних ошибок
NODE_ENV=development

# Необязательно: разрешённые CORS-origin через запятую (по умолчанию — без ограничений, фронт same-origin)
# CORS_ORIGIN=https://example.com
